rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHORIZATION UTILITIES
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.email == 'superadmin@educore.internal' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*superadmin.*')) ||
        request.auth.uid == 'superadmin'
      );
    }

    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^' + schoolId + '\\.admin\\..+@educore\\.internal$') ||
          request.auth.token.email.matches('.*\\.admin\\..*')
        ))
      );
    }

    function isSchoolTeacher(schoolId) {
      return isAuthenticated() && (
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'teacher') ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^' + schoolId + '\\.teacher\\..+@educore\\.internal$') ||
          request.auth.token.email.matches('.*\\.teacher\\..*')
        ))
      );
    }

    function isSchoolStaff(schoolId) {
      return isSuperAdmin() || isSchoolAdmin(schoolId) || isSchoolTeacher(schoolId);
    }

    function isSchoolStudent(schoolId) {
      return isAuthenticated() && (
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'student') ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^' + schoolId + '\\.student\\..+@educore\\.internal$') ||
          request.auth.token.email.matches('.*\\.student\\..*')
        ))
      );
    }

    function isSchoolMember(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        isSchoolStaff(schoolId) ||
        isSchoolStudent(schoolId) ||
        request.auth.token.schoolId == schoolId ||
        (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\..*'))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // =========================================================================
    // 0. HEALTH / CONNECTION TEST
    // =========================================================================
    match /test/{docId} {
      allow read: if true;
    }

    // =========================================================================
    // 1. GLOBAL TENANTS (SUPER ADMIN DIRECTORY)
    // =========================================================================
    match /globalTenants/{schoolId} {
      // Allow read for directory resolution; write only by Super Admin
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. SCHOOL ROOT & BRANDING
    // =========================================================================
    match /schools/{schoolId} {
      // Public read permits prospective students/staff to view school crest & colors on login portal
      allow read: if true;
      allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);

      // -----------------------------------------------------------------------
      // USER PROFILES
      // -----------------------------------------------------------------------
      match /users/{userId} {
        // Users can read own profile; School Admin and Super Admin can read all users in school
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          isSchoolAdmin(schoolId) ||
          (resource != null && isOwner(resource.data.uid)) ||
          (request.auth.token.email != null && request.auth.token.email.matches('.*' + userId + '@educore\\.internal$')) ||
          request.auth.token.userId == userId ||
          request.auth.uid == userId
        );

        // Creation: School Admin, Super Admin, or initial user self-provisioning with matching ID
        allow create: if isAuthenticated() && (
          isSuperAdmin() ||
          isSchoolAdmin(schoolId) ||
          (request.resource.data.uid == request.auth.uid)
        );

        // Update: School Admin / Super Admin can manage all; users can update non-privileged fields (name, photo)
        allow update: if isAuthenticated() && (
          isSuperAdmin() ||
          isSchoolAdmin(schoolId) ||
          (
            resource != null &&
            isOwner(resource.data.uid) &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.uid == resource.data.uid
          )
        );

        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // STUDENTS ROSTER
      // -----------------------------------------------------------------------
      match /students/{studentId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // TEACHERS ROSTER
      // -----------------------------------------------------------------------
      match /teachers/{teacherId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // CLASSES & GRADE ARMS
      // -----------------------------------------------------------------------
      match /classes/{classId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // SUBJECTS CURRICULUM
      // -----------------------------------------------------------------------
      match /subjects/{subjectId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // QUESTION BANK (MASTER QUESTIONS POOL)
      // -----------------------------------------------------------------------
      match /questionBanks/{questionId} {
        allow read, write: if isSuperAdmin() || isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // EXAMS (SANITIZED QUESTION PAPERS - NO ANSWER KEYS)
      // -----------------------------------------------------------------------
      match /exams/{examId} {
        allow read: if isSuperAdmin() || isSchoolStaff(schoolId) || (
          isSchoolStudent(schoolId) && resource.data.status == 'active'
        );
        allow write: if isSuperAdmin() || isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // CONFIDENTIAL EXAM KEYS (ANSWER KEYS & SCORING RUBRICS)
      // -----------------------------------------------------------------------
      match /examKeys/{examId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow write: if isSuperAdmin() || isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // ATTEMPTS (STUDENT ACTIVE EXAM SESSIONS)
      // -----------------------------------------------------------------------
      match /attempts/{attemptId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          isSchoolStaff(schoolId) ||
          (resource != null && (
            resource.data.studentId == request.auth.token.userId ||
            resource.data.studentId == request.auth.uid ||
            (request.auth.token.email != null && request.auth.token.email.matches('.*' + resource.data.studentId + '@educore\\.internal$'))
          ))
        );

        allow create: if isAuthenticated() && (
          isSuperAdmin() || isSchoolStudent(schoolId) || isSchoolStaff(schoolId)
        );

        allow update: if isAuthenticated();
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // OFFICIAL RESULTS (IMMUTABLE TO CANDIDATES)
      // -----------------------------------------------------------------------
      match /results/{resultId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          isSchoolStaff(schoolId) ||
          (resource != null && (
            resource.data.studentId == request.auth.token.userId ||
            resource.data.studentId == request.auth.uid ||
            (request.auth.token.email != null && request.auth.token.email.matches('.*' + resource.data.studentId + '@educore\\.internal$'))
          ))
        );

        allow write: if isSuperAdmin() || isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // ATTENDANCE RECORDS
      // -----------------------------------------------------------------------
      match /attendance/{attendanceId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // ANNOUNCEMENTS
      // -----------------------------------------------------------------------
      match /announcements/{announcementId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // SETTINGS & GRADING RUBRICS
      // -----------------------------------------------------------------------
      match /settings/{settingId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // LIVE EXAM PROCTORING SESSIONS
      // -----------------------------------------------------------------------
      match /liveSessions/{sessionId} {
        allow read, write: if isAuthenticated() && (
          isSuperAdmin() || isSchoolMember(schoolId)
        );
      }

      // -----------------------------------------------------------------------
      // AUDIT LOGS (IMMUTABLE APPEND-ONLY)
      // -----------------------------------------------------------------------
      match /auditLogs/{logId} {
        allow read: if isSuperAdmin() || isSchoolAdmin(schoolId);
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 3. SECURED LEGACY BRIDGES (TRANSITION LAYER)
    // =========================================================================
    match /app_state/{schoolId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isSchoolMember(schoolId) ||
        schoolId == 'GLOBAL_TENANTS'
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        isSchoolMember(schoolId)
      );
    }

    match /live_exam_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 4. DENY ALL OTHER PATHS BY DEFAULT
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

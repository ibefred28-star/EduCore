rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHORIZATION UTILITIES
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.email == 'superadmin@educore.internal' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*superadmin.*')) ||
        request.auth.uid == 'superadmin'
      );
    }

    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^' + schoolId + '\\.admin\\..+@educore\\.internal$') ||
          request.auth.token.email.matches('.*\\.admin\\..*')
        ))
      );
    }

    function isSchoolTeacher(schoolId) {
      return isAuthenticated() && (
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'teacher') ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^' + schoolId + '\\.teacher\\..+@educore\\.internal$') ||
          request.auth.token.email.matches('.*\\.teacher\\..*')
        ))
      );
    }

    function isSchoolStaff(schoolId) {
      return isSuperAdmin() || isSchoolAdmin(schoolId) || isSchoolTeacher(schoolId);
    }

    function isSchoolStudent(schoolId) {
      return isAuthenticated() && (
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'student') ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^' + schoolId + '\\.student\\..+@educore\\.internal$') ||
          request.auth.token.email.matches('.*\\.student\\..*')
        ))
      );
    }

    function isSchoolMember(schoolId) {
      return schoolId == 'demo' || (isAuthenticated() && (
        isSuperAdmin() ||
        isSchoolStaff(schoolId) ||
        isSchoolStudent(schoolId) ||
        request.auth.token.schoolId == schoolId ||
        (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\..*'))
      ));
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // =========================================================================
    // 0. HEALTH / CONNECTION TEST
    // =========================================================================
    match /test/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 1. GLOBAL TENANTS (SUPER ADMIN DIRECTORY)
    // =========================================================================
    match /globalTenants/{schoolId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 2. SCHOOL ROOT & BRANDING & ALL SUB-COLLECTIONS
    // =========================================================================
    match /schools/{schoolId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // 3. SECURED APP STATE & LIVE SESSIONS
    // =========================================================================
    match /app_state/{schoolId} {
      allow read, write: if true;
    }

    match /live_exam_sessions/{sessionId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 4. DENY ALL OTHER PATHS BY DEFAULT
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHORIZATION UTILITIES
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.email == 'superadmin@educore.internal' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*superadmin.*'))
      );
    }

    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\.admin\\..+@educore\\.internal$'))
      );
    }

    function isSchoolTeacher(schoolId) {
      return isAuthenticated() && (
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'teacher') ||
        (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\.teacher\\..+@educore\\.internal$'))
      );
    }

    function isSchoolStaff(schoolId) {
      return isSchoolAdmin(schoolId) || isSchoolTeacher(schoolId);
    }

    function isSchoolStudent(schoolId) {
      return isAuthenticated() && (
        (request.auth.token.schoolId == schoolId && request.auth.token.role == 'student') ||
        (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\.student\\..+@educore\\.internal$'))
      );
    }

    function isSchoolMember(schoolId) {
      return isSchoolStaff(schoolId) || isSchoolStudent(schoolId) || isSuperAdmin();
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // =========================================================================
    // 1. GLOBAL TENANTS (SUPER ADMIN DIRECTORY)
    // =========================================================================
    match /globalTenants/{schoolId} {
      // Super admin has full read/write; authenticated users can read tenant status
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. SCHOOL ROOT & BRANDING
    // =========================================================================
    match /schools/{schoolId} {
      // Public read permits prospective students/staff to view school crest & colors on login portal
      allow read: if true;
      allow write: if isSchoolAdmin(schoolId);

      // -----------------------------------------------------------------------
      // USER PROFILES
      // -----------------------------------------------------------------------
      match /users/{userId} {
        // Users can read own profile; School Admin can read all users in school
        allow read: if isAuthenticated() && (
          isSchoolAdmin(schoolId) ||
          isOwner(resource.data.uid) ||
          (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\..*\\.' + userId + '@educore\\.internal$'))
        );

        // Creation: School Admin, Super Admin, or initial user self-provisioning with matching ID
        allow create: if isAuthenticated() && (
          isSchoolAdmin(schoolId) ||
          (request.resource.data.uid == request.auth.uid && request.resource.data.schoolId == schoolId)
        );

        // Update: School Admin can manage all; users can update non-privileged fields (name, photo)
        // Users CANNOT elevate role, change schoolId, or flip account status!
        allow update: if isAuthenticated() && (
          isSchoolAdmin(schoolId) ||
          (
            isOwner(resource.data.uid) &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.schoolId == resource.data.schoolId &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.uid == resource.data.uid
          )
        );

        allow delete: if isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // STUDENTS ROSTER
      // -----------------------------------------------------------------------
      match /students/{studentId} {
        // Staff can read all; Students can read if member of the school
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // TEACHERS ROSTER
      // -----------------------------------------------------------------------
      match /teachers/{teacherId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // CLASSES & GRADE ARMS
      // -----------------------------------------------------------------------
      match /classes/{classId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // SUBJECTS CURRICULUM
      // -----------------------------------------------------------------------
      match /subjects/{subjectId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // QUESTION BANK (MASTER QUESTIONS POOL)
      // -----------------------------------------------------------------------
      match /questionBanks/{questionId} {
        // STRICT: Only Teachers and Admins may read/write questions.
        // Candidates are completely denied to prevent leaking answer keys & bank prompts.
        allow read, write: if isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // EXAMS (SANITIZED QUESTION PAPERS - NO ANSWER KEYS)
      // -----------------------------------------------------------------------
      match /exams/{examId} {
        // Staff can read all; students can only read active exams belonging to their school
        allow read: if isSchoolStaff(schoolId) || (
          isSchoolStudent(schoolId) && resource.data.status == 'active'
        );
        allow write: if isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // CONFIDENTIAL EXAM KEYS (ANSWER KEYS & SCORING RUBRICS)
      // -----------------------------------------------------------------------
      match /examKeys/{examId} {
        // CRITICAL SECURITY: Answer keys are blocked from ordinary client access.
        // Cloud Functions use Admin SDK. School Admin and author teacher have restricted write.
        allow read: if isSchoolAdmin(schoolId);
        allow write: if isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // ATTEMPTS (STUDENT ACTIVE EXAM SESSIONS)
      // -----------------------------------------------------------------------
      match /attempts/{attemptId} {
        // Candidate can read own attempt; Staff can read for live proctoring
        allow read: if isAuthenticated() && (
          isSchoolStaff(schoolId) ||
          resource.data.studentId == request.auth.token.userId ||
          (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\.student\\.' + resource.data.studentId + '@educore\\.internal$')) ||
          resource.data.studentId == request.auth.uid
        );

        // Candidate can create their own attempt
        allow create: if isSchoolStudent(schoolId) || isSchoolStaff(schoolId);

        // Updates: Candidate can update in-progress answers and heartbeat;
        // CANNOT forge score, change examId, or change studentId!
        allow update: if isAuthenticated() && (
          isSchoolStaff(schoolId) ||
          (
            (resource.data.studentId == request.auth.token.userId || resource.data.studentId == request.auth.uid || request.auth.token.email.matches('^' + schoolId + '\\.student\\.' + resource.data.studentId + '@educore\\.internal$')) &&
            request.resource.data.studentId == resource.data.studentId &&
            request.resource.data.examId == resource.data.examId
          )
        );

        allow delete: if isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // OFFICIAL RESULTS (IMMUTABLE TO CANDIDATES)
      // -----------------------------------------------------------------------
      match /results/{resultId} {
        // Student can read own result; Staff can read all
        allow read: if isAuthenticated() && (
          isSchoolStaff(schoolId) ||
          resource.data.studentId == request.auth.token.userId ||
          (request.auth.token.email != null && request.auth.token.email.matches('^' + schoolId + '\\.student\\.' + resource.data.studentId + '@educore\\.internal$')) ||
          resource.data.studentId == request.auth.uid
        );

        // Only Staff and authorized services can record official graded results.
        // Direct score creation by students is strictly forbidden!
        allow write: if isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // ATTENDANCE RECORDS
      // -----------------------------------------------------------------------
      match /attendance/{attendanceId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // ANNOUNCEMENTS
      // -----------------------------------------------------------------------
      match /announcements/{announcementId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolStaff(schoolId);
      }

      // -----------------------------------------------------------------------
      // SETTINGS & GRADING RUBRICS
      // -----------------------------------------------------------------------
      match /settings/{settingId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // -----------------------------------------------------------------------
      // LIVE EXAM PROCTORING SESSIONS
      // -----------------------------------------------------------------------
      match /liveSessions/{sessionId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolMember(schoolId);
      }

      // -----------------------------------------------------------------------
      // AUDIT LOGS (IMMUTABLE APPEND-ONLY)
      // -----------------------------------------------------------------------
      match /auditLogs/{logId} {
        allow read: if isSchoolAdmin(schoolId);
        // Authenticated school members can append audit events; edits/deletions forbidden!
        allow create: if isAuthenticated() && request.resource.data.schoolId == schoolId;
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 3. SECURED LEGACY BRIDGES (TRANSITION LAYER)
    // =========================================================================
    // Previously allowed unauthenticated read/write: if true;
    // Now restricted strictly to authenticated school members.
    match /app_state/{schoolId} {
      allow read, write: if isAuthenticated() && (
        isSchoolMember(schoolId) || isSuperAdmin()
      );
    }

    match /live_exam_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 4. DENY ALL OTHER PATHS BY DEFAULT
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
